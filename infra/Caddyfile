{
	email {$ACME_EMAIL}
	# If the UDP/443 measurement failed, uncomment this AND drop the udp port mapping — never
	# one without the other: browsers cache the alt-svc advertisement for up to 30 days, so a
	# mismatch leaves some clients unable to open the site while others load fine.
	# servers {
	# 	protocols h1 h2
	# }
}

{$FRONTEND_DOMAIN} {
	encode zstd gzip

	# /api/* is routed HERE rather than through a Next.js rewrite.
	#
	# Next bakes next.config.ts into the standalone build, so a rewrite target would be frozen
	# at build time and the image could only ever run in one environment. Routing by path in
	# Caddy keeps one image portable AND keeps the browser on a single origin, so the session
	# cookie is simply sent with every request and there is no cross-site cookie problem.
	handle /api/* {
		reverse_proxy api:4100
	}

	handle {
		reverse_proxy web:4101
	}

	log {
		output stdout
		format json
	}
}

# The API is also reachable on its own hostname, for health checks and any future integration.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4100
	log {
		output stdout
		format json
	}
}
