// Times are SMALLINT minutes since LOCAL midnight; dates are DATE. Never UTC timestamps for
// appointment times — Lebanon observes DST and has changed it at short notice, and a customer
// told "14:00" must stay 14:00 whatever tzdata does. Only createdAt/updatedAt are instants.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Turbopack cannot resolve the ".js" suffixes Prisma emits by default when it compiles this
  // as source, so the generated imports carry no extension and the bundler resolves them.
  importFileExtension = ""
}

datasource db {
  // Prisma 7 removed `url` from this block: migrations read it from prisma.config.ts, and the
  // runtime client gets a driver adapter instead (see infrastructure/prisma).
  provider = "postgresql"
}

/// How precisely we know where a location actually is. Customers give whatever detail they
/// have — "Saida", "Tripoli, Mina", a landmark, or a Maps link. Every level books normally.
enum LocationPrecision {
  LOCALITY
  SUBLOCALITY
  LANDMARK
  EXACT
}

/// Whether the customer was held to an exact minute, or merely placed inside their window.
enum Flexibility {
  HARD
  MOVEABLE_WITHIN_WINDOW
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  locations    Location[]
  appointments Appointment[]

  @@index([name])
  @@map("customers")
}

/// Purely organisational: filtering, grouping, colour on the map. No geometry, no boundaries.
/// Routing NEVER reads this — it is a business grouping, not a geographic truth.
model PlanningArea {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  colorToken  String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  localities Locality[]

  @@map("planning_areas")
}

/// A reusable dictionary of named places, earning its table by serving two needs at once:
/// it records which area a place belongs to (Anfeh -> Tripoli Area) exactly once, and its
/// centroid is the coordinate the engine routes to when a customer says only "Saida".
model Locality {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  planningAreaId    String   @map("planning_area_id") @db.Uuid
  centroidLatitude  Decimal  @map("centroid_latitude") @db.Decimal(9, 6)
  centroidLongitude Decimal  @map("centroid_longitude") @db.Decimal(9, 6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  planningArea PlanningArea @relation(fields: [planningAreaId], references: [id], onDelete: Restrict)
  locations    Location[]

  @@index([planningAreaId])
  @@map("localities")
}

model Location {
  id         String            @id @default(uuid()) @db.Uuid
  customerId String            @map("customer_id") @db.Uuid
  label      String?
  /// Verbatim what the customer said. A label for humans, never an input to routing.
  addressText String           @map("address_text")
  localityId String?           @map("locality_id") @db.Uuid
  precision  LocationPrecision @default(EXACT)
  latitude   Decimal           @db.Decimal(9, 6)
  longitude  Decimal           @db.Decimal(9, 6)
  /// Derived free from the coordinates; the practical way to hand a spot to a driver.
  plusCode      String? @map("plus_code")
  /// "Blue building, entrance behind the pharmacy." How the team finds the door.
  landmarkNotes String? @map("landmark_notes")
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  locality     Locality?     @relation(fields: [localityId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([customerId])
  @@index([localityId])
  @@map("locations")
}

model Appointment {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid

  /// Local calendar date in Asia/Beirut. No time, no zone.
  date DateTime @db.Date

  /// What the customer was told. A hard pin during simulation; moves only by human action.
  promisedStart          Int @map("promised_start") @db.SmallInt
  windowStart            Int @map("window_start") @db.SmallInt
  windowEnd              Int @map("window_end") @db.SmallInt
  serviceDurationMinutes Int @map("service_duration_minutes") @db.SmallInt

  flexibility Flexibility       @default(MOVEABLE_WITHIN_WINDOW)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([date, status])
  @@index([customerId])
  @@map("appointments")
}

/// Cached driving legs, keyed by coordinates snapped to ~11 m.
///
/// This is the whole cost story: under traffic-unaware routing travel time depends on
/// coordinates, not on the time of day, so dragging a time slider re-uses these rows and
/// costs nothing. Only a change of LOCATION can miss the cache.
model TravelLeg {
  id              String   @id @default(uuid()) @db.Uuid
  originKey       String   @map("origin_key")
  destinationKey  String   @map("destination_key")
  durationSeconds Int      @map("duration_seconds")
  distanceMetres  Int      @map("distance_metres")
  /// True when this came from the fallback estimator rather than the road network.
  estimated       Boolean  @default(false)
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@unique([originKey, destinationKey])
  @@index([fetchedAt])
  @@map("travel_legs")
}

/// Cached road geometry for a settled sequence, keyed by a hash of the ordered coordinates.
model RouteGeometry {
  id            String   @id @default(uuid()) @db.Uuid
  sequenceHash  String   @unique @map("sequence_hash")
  encodedPolyline String @map("encoded_polyline")
  fetchedAt     DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@map("route_geometries")
}

/// Singleton. Business config the owner can change without a redeploy.
model DaySettings {
  id                    String   @id @default("singleton")
  depotLatitude         Decimal  @map("depot_latitude") @db.Decimal(9, 6)
  depotLongitude        Decimal  @map("depot_longitude") @db.Decimal(9, 6)
  depotLabel            String   @map("depot_label")
  workdayStart          Int      @map("workday_start") @db.SmallInt
  workdayEnd            Int      @map("workday_end") @db.SmallInt
  defaultServiceMinutes Int      @map("default_service_minutes") @db.SmallInt
  /// Parking, finding the door, getting inside. Real time that is not travel time.
  accessBufferMinutes   Int      @map("access_buffer_minutes") @db.SmallInt
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  @@map("day_settings")
}
