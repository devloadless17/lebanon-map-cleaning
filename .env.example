# ─── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL='postgresql://lebanon:lebanon@localhost:5433/lebanon_cleaning?schema=public'

# ─── API ─────────────────────────────────────────────────────────────────────────
PORT='4100'
NODE_ENV='development'
# openssl rand -base64 48
SESSION_SECRET='dev-only-change-me-dev-only-change-me-dev-only-ch'
# Exact origin, https in production, NEVER a trailing slash — CORS compares strings.
FRONTEND_ORIGIN='http://localhost:4101'

# ─── Google Maps Platform ────────────────────────────────────────────────────────
# Server key: IP-restricted, enabled for Routes API + Geocoding API. Never sent to a browser.
# Leave empty to run entirely on the straight-line fallback estimator (no Google account needed).
GOOGLE_MAPS_SERVER_KEY=''

# ─── Map tiles (optional) ────────────────────────────────────────────────────────
# The map works with NO configuration: real OpenStreetMap tiles, no key, no account.
# Override only if you outgrow OSM's tile policy and move to a paid or self-hosted provider.
# NEXT_PUBLIC_MAP_TILE_URL='https://{s}.example-tiles.com/{z}/{x}/{y}.png'
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; Example'

# ─── Web (NEXT_PUBLIC_* are baked in at BUILD time — changing one needs a rebuild) ──
# OPTIONAL. Everything below is only needed if you want Google's basemap and real road
# distances instead of the free map and straight-line estimates. Requires a Google Cloud
# billing account. Leave empty and the app works fully.
# Browser key: HTTP-referrer-restricted, enabled for Maps JavaScript API + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=''
# Required for Advanced Markers. Inline styles[] were decommissioned in 2025, so map styling
# lives in the Cloud console against this ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=''
NEXT_PUBLIC_API_ORIGIN='http://localhost:4100'
