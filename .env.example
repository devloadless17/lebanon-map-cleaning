# ─── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL='postgresql://lebanon:lebanon@localhost:5433/lebanon_cleaning?schema=public'

# ─── Session ─────────────────────────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET='dev-only-change-me-dev-only-change-me-dev-only-ch'

# NODE_ENV is deliberately absent. Next sets it itself — development for `next dev`,
# production for `build` and `start`. Pinning it here produces a development build that
# cannot prerender, and on Vercel it overrides the platform's own value.

# ─── Google Maps Platform (all optional) ─────────────────────────────────────────
# Leave every key empty and the app still works fully: an OpenStreetMap basemap and
# straight-line distance estimates, with no Google account and no billing.
#
# Server key: API-restricted to Routes + Geocoding, with no IP restriction — a serverless
# deployment has no fixed IP to pin. Never sent to a browser.
GOOGLE_MAPS_SERVER_KEY=''

# ─── Web ─────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* are compiled into the client bundle at BUILD time, not read at runtime.
# Changing one means rebuilding — restarting will not pick it up.
#
# Browser key: HTTP-referrer-restricted, enabled for Maps JavaScript API + Places API (New).
# The referrer list must include the deployed hostname or the map falls back to OpenStreetMap.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=''
# Required for Advanced Markers. Inline styles[] were decommissioned in 2025, so map styling
# lives in the Cloud console against this ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=''

# ─── Map tiles (optional) ────────────────────────────────────────────────────────
# Only needed if you outgrow OpenStreetMap's tile policy and move to another provider.
# NEXT_PUBLIC_MAP_TILE_URL='https://{s}.example-tiles.com/{z}/{x}/{y}.png'
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION='&copy; Example'
