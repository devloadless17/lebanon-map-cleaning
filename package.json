{
  "name": "lebanon-cleaning",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n contracts,web -c gray,magenta \"npm:dev:contracts\" \"npm:dev:web\"",
    "build": "npm run build --workspace @lebanon/contracts && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:contracts": "npm run dev --workspace @lebanon/contracts",
    "dev:web": "npm run dev --workspace @lebanon/web",
    "db:migrate": "npm run db:migrate --workspace @lebanon/core",
    "db:deploy": "npm run db:deploy --workspace @lebanon/core",
    "db:seed": "npm run db:seed --workspace @lebanon/core",
    "demo:reset": "npm run demo:reset --workspace @lebanon/core"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true
  }
}
